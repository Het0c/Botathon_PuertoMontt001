# Desarrollo local (SQLite). Copiar este archivo como .env y cambiar las claves.
DATABASE_URL=sqlite:///./backend-local.db
RPA_API_KEY=cambiar-por-un-secreto-de-al-menos-24-caracteres
USER_API_KEY=cambiar-por-otro-secreto-de-al-menos-24-caracteres
ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development

# Producción / Supabase: descomentar estas líneas y comentar la DATABASE_URL de arriba.
# Usar la cadena PostgreSQL del pooler de Supabase (puerto 6543).
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:6543/postgres
# SUPABASE_JWT_SECRET=secreto-jwt-del-proyecto